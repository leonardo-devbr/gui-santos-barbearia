# O usuário root é adequado apenas para desenvolvimento local
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD="troque-por-sua-senha"
MYSQL_DATABASE=gui_santos_barbearia
MYSQL_SSL=false
MYSQL_CONNECTION_LIMIT=10
# Use false quando a hospedagem já entregar o banco criado, como no Northflank
MYSQL_CREATE_DATABASE=true

# Opcionais: credencial temporária com permissão de DDL para npm run db:setup
# MYSQL_SETUP_USER=
# MYSQL_SETUP_PASSWORD=

# Opcional: certificado PEM da autoridade do MySQL, codificado em base64
# MYSQL_SSL_CA_BASE64=

# Usadas somente pelo comando npm run admin:create
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@exemplo.com"
ADMIN_PASSWORD="troque-por-uma-senha-forte"

# Opcionais: contas prontas para um ambiente descartável de homologação
# Nunca mantenha estas senhas configuradas depois de executar npm run test-users:seed
# SEED_TEST_USERS=false
# SEED_CUSTOMER_NAME="Cliente de Teste"
# SEED_CUSTOMER_PHONE=11999999999
# SEED_CUSTOMER_EMAIL=cliente@exemplo.com
# SEED_CUSTOMER_PASSWORD="troque-por-uma-senha-forte"
# SEED_ADMIN_NAME="Administrador de Teste"
# SEED_ADMIN_EMAIL=admin@exemplo.com
# SEED_ADMIN_PASSWORD="troque-por-uma-senha-forte"
# SEED_BARBER_NAME="Barbeiro de Teste"
# SEED_BARBER_EMAIL=barbeiro@exemplo.com
# SEED_BARBER_PASSWORD="troque-por-uma-senha-forte"
# SEED_BARBER_ID=guilherme

# URL pública usada nos links enviados por e-mail; use HTTPS em produção
APP_URL=http://localhost:3000

# Opcional e somente local: exibe o link de recuperação diretamente na tela
DEV_EXPOSE_PASSWORD_RESET_URL=false

# Opcional e somente local: exibe links de confirmação de e-mail diretamente na tela
DEV_EXPOSE_EMAIL_VERIFICATION_URL=false

# Configure somente com um cabeçalho de IP que sua hospedagem sobrescreve e protege
TRUSTED_PROXY_IP_HEADER=

# E-mail transacional via SMTP (porta 465 usa TLS direto; 587 exige STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Protege o processamento automático de lembretes e tentativas de reenvio
CRON_SECRET=
