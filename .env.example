MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD="troque-por-sua-senha"
MYSQL_DATABASE=gui_santos_barbearia

# Usadas somente pelo comando npm run admin:create
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@exemplo.com"
ADMIN_PASSWORD="troque-por-uma-senha-forte"

# URL pública usada nos links enviados por e-mail
APP_URL=http://localhost:3000

# Opcional e somente local: exibe o link de recuperação diretamente na tela
DEV_EXPOSE_PASSWORD_RESET_URL=false

# E-mail transacional via SMTP (porta 465 usa TLS direto; 587 usa STARTTLS)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Protege o processamento automático de lembretes e tentativas de reenvio
CRON_SECRET=
